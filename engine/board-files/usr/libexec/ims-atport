#!/bin/sh
# ims-atport —— 按优先级列出 Quectel 模组的候选 AT 口（全部由 sysfs 动态发现）
#
# 用法:
#   ims-atport            列出两个模组的候选 AT 口，每行一个 /dev/ttyUSBx
#   ims-atport at t       只列 EC200T 的口
#   ims-atport at n       只列 EC200N 的口
#
# 输出按「接口号从大到小」排序：同一模组内 :1.4 排最前，然后 :1.3 ……
# 被别的进程独占的口（例如 pppd 占了 :1.4）不需要在这里排除 ——
# 调用方 open 时会拿不到（EAGAIN），自然落到下一个候选。
#
# ★★★ 为什么不写死 ttyUSB 编号 ★★★
#   USB 每次重枚举，串口编号会整体平移。实测同一台设备不同次启动里，
#   EC200T 的 AT 口在 ttyUSB1 与 ttyUSB2 之间变过。
#   2026-10-30 的事故就是这么来的：面板按「接口 :1.4」写死取口，
#   EC200T 走 PPP 拨号时 pppd 正好独占 :1.4 → 插件一律判定"模组无响应"，
#   卡明明插在上面却读不到、短信发不出、面板把模组显示成离线。
#   结论：一律按 sysfs 的 idProduct + 接口号动态判定，不认 ttyUSB 数字。

PID_EC200T=6026    # 2c7c:6026  Quectel EC200T
PID_EC200N=6002    # 2c7c:6002  Quectel EC200N

# 从 /sys/class/tty/<name>/device 往上找 idProduct
pid_of() {
	_d=$(readlink -f "/sys/class/tty/$1/device" 2>/dev/null)
	_n=0
	while [ -n "$_d" ] && [ "$_d" != "/" ] && [ "$_n" -lt 6 ]; do
		if [ -e "$_d/idProduct" ]; then
			cat "$_d/idProduct" 2>/dev/null
			return 0
		fi
		_d="${_d%/*}"
		_n=$((_n + 1))
	done
	return 1
}

# 取 USB 接口号（.../1-1.1:1.4/ttyUSB2 → 4）
iface_of() {
	_d=$(readlink -f "/sys/class/tty/$1/device" 2>/dev/null)
	case "$_d" in
	*:1.[0-9]*) printf '%s\n' "${_d##*:1.}" | cut -d/ -f1 ;;
	*) echo 0 ;;
	esac
}

_want=''
case "$1" in
at) case "$2" in
	t|T|ec200t|EC200T) _want=$PID_EC200T ;;
	n|N|ec200n|EC200N) _want=$PID_EC200N ;;
	esac ;;
esac

for _t in /sys/class/tty/ttyUSB*; do
	[ -e "$_t" ] || continue
	_n="${_t##*/}"
	_p=$(pid_of "$_n") || continue
	# 只保留本项目这两种模组，别的 USB 串口（调试线等）不掺和
	case "$_p" in
	"$PID_EC200T"|"$PID_EC200N") ;;
	*) continue ;;
	esac
	[ -n "$_want" ] && [ "$_p" != "$_want" ] && continue
	# Quectel EC200 系列的接口布局是固定的：:1.0/:1.1 = RNDIS（网络），
	# :1.2 = DM 诊断口，:1.3/:1.4 才是 AT 口。低于 3 的口实测不认 AT，
	# 放进候选只会让调用方白等一轮超时（start 期间还持着服务锁，代价很大）。
	_if=$(iface_of "$_n")
	[ "$_if" -ge 3 ] 2>/dev/null || continue
	# 接口号补零后整行倒排：:1.4 的口一定排在 :1.3 前面。
	# （busybox 的 sort 不支持 `-k1,1r` 这种字段修饰符，只能整行倒排；
	#   同一接口号内部谁在前不影响正确性 —— 调用方会逐个探测到能用的那个）
	printf '0%s %s\n' "$_if" "$_n"
done | sort -r | awk '{print "/dev/" $2}'
