	on) cmd_fun_on "$_c" ;;
	off) cmd_fun_off "$_c" ;;
	*) die "未知子命令: $1" ;;
	esac
	;;
sms)
	[ $# -ge 1 ] || die "用法: $ME sms {list|delete|send|inbox} ..."
	_sub="$1"; shift
	case "$_sub" in
	list) [ $# -ge 1 ] || die "用法: $ME sms list <目标>"; cmd_sms_list "$1" ;;
	delete) [ $# -ge 2 ] || die "用法: $ME sms delete <目标> <索引>"; cmd_sms_delete "$1" "$2" ;;
	fwdtest) /usr/libexec/fzs-fwd "转发测试" "$(date '+%Y-%m-%d %H:%M:%S')" "这是一条测试消息——看到它说明短信转发配置成功。" && printf '{"ok":true}\n' || printf '{"ok":false,"err":"发送失败（请检查：是否启用转发、渠道与凭据、设备能否上网）"}\n' ;;
	# caps：把"本机具备哪些转发能力"告诉前端（页面据此决定要不要提示补装组件）。
	#   ★ 2026-10-08 加：国内机器人（企微/钉钉/飞书）与 Telegram 需要能设
	#     Content-Type 的 HTTP 客户端（GNU wget，来自 wget-ssl 包）；
	#     系统自带的是 uclient-fetch（发不了 JSON）。这里如实上报，
	#     前端只在"用户勾了这些渠道 且 json==0"时，给一个可点击的安装提示。
	caps)
		_json=0
		if command -v wget >/dev/null 2>&1 && wget --help 2>&1 | grep -q -- '--header'; then
			_json=1
		fi
		printf '{"json":%s}\n' "$_json"
		;;
	drop) [ $# -ge 2 ] || die "用法: $ME sms drop <目标> <索引>"; cmd_sms_drop "$1" "$2" ;;
	delmulti) [ $# -ge 2 ] || die "用法: $ME sms delmulti <目标> <索引列表>"; cmd_sms_delmulti "$1" "$2" ;;
	# clear/clearout 与守护的 poll 都会「读-改-写」收件箱/发件箱文件，
	# 必须用同一把文件锁串行化（否则并发时新的覆盖旧的，或清空被回写覆盖）
	clear) ( flock 9; UC_SUB=clear ucode /usr/libexec/fzs-sms.uc ) 9>/tmp/fzs-sms-state.lock ;;
	clearout) ( flock 9; UC_SUB=clearout ucode /usr/libexec/fzs-sms.uc ) 9>/tmp/fzs-sms-state.lock ;;
	# 单条删除留底：同样要「读-改-写」发件箱，用同一把锁
	dropout) [ $# -ge 3 ] || die "用法: $ME sms dropout <时间戳> <模组> <号码>"; ( flock 9; UC_SUB=dropout UC_ARG1="$1" UC_ARG2="$2" UC_ARG3="$3" ucode /usr/libexec/fzs-sms.uc ) 9>/tmp/fzs-sms-state.lock ;;
	send) [ $# -ge 3 ] || die "用法: $ME sms send <目标> <号码> <内容>"; cmd_sms_send "$1" "$2" "$3" ;;
	inbox) cmd_sms_inbox ;;
	csca) [ $# -ge 1 ] || die "用法: $ME sms csca <目标>"; cmd_sms_csca "$1" ;;
	*) die "未知子命令: $_sub" ;;
	esac
	;;
ims)
	# ── IMS 引擎（imsengine）对接 [ims-bridge] 2026-10-20 ──────────────────
	#   200T(EC200T) 固件不会向网络要 P-CSCF，也没有 AT 能读；
	#   200N(EC200N) 固件自带 IMS。故提供 learn：把卡临时插到 200N，
	#   借它的原生 IMS 把 P-CSCF 读出来存盘，卡插回 200T 即刻可用。
	[ $# -ge 1 ] || die "用法: $ME ims {learn|status} ..."
	_sub="$1"; shift
	case "$_sub" in
	# $1 = 可选的学习源 AT 口（省略则自动找 200N 的口）
	learn) cmd_ims_learn "$1" ;;
	# 引擎状态：给面板显示"IMS 是否已注册 / 当前 P-CSCF"
	status) cmd_ims_status ;;
	# [ims-bypass] 探测"固件自带 IMS 栈且已注册"的模组: 输出 "<target> <at口>"
	native) cmd_ims_native ;;
	# ★ 0.1.8 [diag]: 一键诊断报告（面板「导出诊断日志」按钮调它）
	#   转发给 init.d —— 诊断逻辑放在 imsengine 包里维护，面板只做入口，
	#   这样面板与引擎版本可以各自独立升级，不会因为面板旧了就没有诊断能力。
	#   走 fzs-at 而不用直连 /etc/init.d/ims，是为了复用现有 ACL 白名单
	#   （acl.d 已放通 "fzs-at * * * *"），升级面板后不必额外重启 rpcd。
	diag) exec /etc/init.d/ims diag ;;
	*) die "未知子命令: $_sub" ;;
	esac
	;;
sim)
	# [sim-reset] 2026-10-25：读卡状态查询 + 强制重新初始化（免重启整机）
	[ $# -ge 1 ] || die "用法: $ME sim {status|reset} [目标]"
	_sub="$1"; shift
	case "$_sub" in
	status) cmd_sim_status "$1" ;;
	reset) cmd_sim_reset "$1" ;;
	*) die "未知子命令: $_sub" ;;
	esac
	;;
imei)
	[ $# -ge 1 ] || die "用法: $ME imei {read|write} ..."
	_sub="$1"; shift
	case "$_sub" in
	read)
		printf '['
		if [ -n "$1" ]; then
			printf '{"name":"%s","imei":"%s"}' "$(target_name "$1")" "$(imei_read_one "$(target_to_port "$1")")"
		else
			printf '{"name":"%s","imei":"%s"},' "$(target_name 1)" "$(imei_read_one "$(target_to_port 1)")"
			printf '{"name":"%s","imei":"%s"}' "$(target_name 2)" "$(imei_read_one "$(target_to_port 2)")"
		fi
		printf ']\n'
		;;
	write)
		[ $# -ge 3 ] || die "用法: $ME imei write <15位IMEI> <目标> --yes"
		_imei="$1"; _tgt="$2"; _yes="$3"
		case "$_imei" in ''|*[!0-9]*) die "IMEI 必须是纯数字" ;; esac
		[ "${#_imei}" -eq 15 ] || die "IMEI 必须 15 位"
		[ "$_yes" = "--yes" ] || die "需要 --yes 确认"
		_p=$(target_to_port "$_tgt") || die "找不到 $_tgt 的 AT 口"
		if imei_write_one "$_p" "$_imei"; then
			printf '{"ok":true,"imei":"%s"}\n' "$_imei"
		else
			printf '{"ok":false,"err":"回读不一致"}\n'
		fi
		;;
	*) die "未知子命令: $_sub" ;;
	esac
	;;
*) die "未知命令: $CMD" ;;
esac
exit $?
