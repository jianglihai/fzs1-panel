#!/bin/sh
# fzs-at —— 蜂助手面板 AT 助手（luci-app-fzs 自带）
# AT 访问优先走内置的 fzs-atio（逐条握手、毫秒超时、不碰 DTR/RTS；源码 src/fzs-atio/），
# 缺失时回退 picocom（★ 回退路径绝不能加 --noinit：端口非 raw、ECHO 常开会污染数据，见 AT 文档）
# 用法: fzs-at info [目标] | imei read [目标] | imei write <15位IMEI> <目标> --yes | ports
#       | apn read [目标] | apn write <目标> <APN> | data <on|off> <目标>
#       | fun <on|off> <目标> | sms {list|delete|send|inbox} ...
# 目标: ec200t | ec200n | 1 | 2 | ttyUSBn（省略 = 两个模组）
# 踩坑记录见 docs/AT口回显风暴-根因与对策.md

ME="fzs-at"
PID_EC200T=6026
PID_EC200N=6002

die() { echo "$ME: $*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# AT 访问工具的选择（2026-10-07 大改）
#   ★ 首选 /usr/bin/fzs-atio：一次调用跑完整个会话，逐条"发一条 → 等到 OK/ERROR
#     → 再发下一条"，毫秒级超时。没有固定 sleep 盲等，也不需要整轮重发。
#     实测：两个模组并行 0.3 秒（老 picocom 方案 14 秒）。
#   ★ 回退 picocom / socat：万一 fzs-atio 缺失或跑不起来（老版本升级残留、
#     架构不符等），自动退回老方案 —— 功能不受影响，只是慢。
# ---------------------------------------------------------------------------
ATIO_BIN=""
if [ -x /usr/bin/fzs-atio ]; then ATIO_BIN=/usr/bin/fzs-atio; fi
ATIO_TIMEOUT=800

AT_TOOL=""
if command -v picocom >/dev/null 2>&1; then AT_TOOL=picocom
elif command -v socat >/dev/null 2>&1; then AT_TOOL=socat
fi

if [ -z "$ATIO_BIN" ] && [ -z "$AT_TOOL" ]; then
	die "缺少 fzs-atio / picocom / socat，无法访问 AT 口"
fi

find_up() {
	_d="$1"; _f="$2"; _n=0
	while [ -n "$_d" ] && [ "$_d" != "/" ] && [ "$_n" -lt 6 ]; do
		[ -e "$_d/$_f" ] && { echo "$_d"; return 0; }
		_d="${_d%/*}"; _n=$((_n+1))
	done
	return 1
}

# 探测一个 ttyUSB 是否**真能**当 AT 口用（能回 OK）。
#
# ★ 2026-10-30 实测故障：口存在 ≠ 口可用。
#   EC200T 用 PPP 拨号时，固件的 pppd 会独占它的 AT 口：
#       pppd /dev/ttyUSB2 115200 connect chat "" AT OK ATD*99***1# CONNECT
#   此时 open("/dev/ttyUSB2") 直接返回 EAGAIN（"Resource temporarily
#   unavailable"）。而下面 find_at_by_pid 原先只按 sysfs 路径里的 `:1.4`
#   挑口，必然挑中这个被占的口 → 上层一律报"模组无响应"，
#   面板把模组显示成离线，短信也发不出去（卡插在那个模组上也读不到）。
#   所以这里必须**实际发一条 AT**，谁回 OK 谁才是 AT 口。
probe_at() {
	[ -n "$ATIO_BIN" ] && [ -c "/dev/$1" ] || return 1
	# 锁文件与 at_query 用同一个：短信轮询每 2 秒就开一次串口，
	# 两边若各用一把锁会同时 open 同一个 tty，双方都拿到 EAGAIN 而互相误判。
	_r=$( { flock 9
		printf 'AT\n'
	} 9>"/tmp/fzs-at-${1}.lock" | "$ATIO_BIN" -t 600 -d 100 "/dev/$1" 2>/dev/null )
	case "$_r" in *OK*) return 0 ;; esac
	return 1
}

find_at_by_pid() {
	_pid="$1"
	_cf="/tmp/fzs-at-port-$_pid"
	# 端口选择结果缓存 60 秒：短信守护每 2 秒轮询一次，每轮都实测会多花
	# 600ms；而被独占的口在开机后基本是稳定状态（pppd 起来就不再变）。
	if [ -f "$_cf" ]; then
		_cp=$(cut -d' ' -f1 "$_cf" 2>/dev/null)
		_ct=$(cut -d' ' -f2 "$_cf" 2>/dev/null)
		case "$_ct" in ''|*[!0-9]*) _ct=0 ;; esac
		if [ -n "$_cp" ] && [ -c "/dev/$_cp" ] \
		   && [ $(($(date +%s) - _ct)) -lt 60 ]; then
			echo "$_cp"; return 0
		fi
	fi
	# 收集该模组的全部串口；:1.4 排最前（历史 AT 口就在那，命中时省一次探测）
	_pref=''; _list=''
	for _d in /sys/class/tty/ttyUSB*; do
		[ -e "$_d" ] || continue
		_n="${_d##*/}"
		_r=$(readlink -f "$_d/device" 2>/dev/null)
		_dd=$(find_up "$_r" idProduct) || continue
		[ "$(cat "$_dd/idProduct" 2>/dev/null)" = "$_pid" ] || continue
		case "$_r" in *:1.4*) _pref="$_n" ;; esac
		_list="$_list $_n"
	done
	# 没有 fzs-atio 就没法实测：退回老的路径判断，保证还能凑合用
	if [ -z "$ATIO_BIN" ]; then
		[ -n "$_pref" ] && { echo "$_pref"; return 0; }
		return 1
	fi
	for _n in $_pref $_list; do
		probe_at "$_n" || continue
		printf '%s %s\n' "$_n" "$(date +%s)" > "$_cf" 2>/dev/null
		echo "$_n"; return 0
	done
	return 1
}

port_model() {
	_r=$(readlink -f "/sys/class/tty/$1/device" 2>/dev/null)
	_dd=$(find_up "$_r" idProduct) || { echo "?"; return 0; }
	case "$(cat "$_dd/idProduct" 2>/dev/null)" in
	"$PID_EC200T") echo "EC200T" ;;
	"$PID_EC200N") echo "EC200N" ;;
	*) echo "?" ;;
	esac
}

target_to_port() {
	case "$1" in
	ttyUSB*) [ -c "/dev/$1" ] && { echo "$1"; return 0; }; return 1 ;;
	ec200t|EC200T|1|modem1|t|T) find_at_by_pid "$PID_EC200T" ;;
	ec200n|EC200N|2|modem2|n|N) find_at_by_pid "$PID_EC200N" ;;
	*) return 1 ;;
	esac
}

target_name() {
	case "$1" in
	1|modem1|ec200t|EC200T) echo "模组1 (EC200T)" ;;
	2|modem2|ec200n|EC200N) echo "模组2 (EC200N)" ;;
	*) echo "$1" ;;
	esac
}

# 模组崩溃重启后，RNDIS 接口会变回 usb0/usb1，而固件不会自动改回来
# （/etc/hotplug.d 里没有 rndis 规则，改名只在开机时跑一次）→ 网络会永久起不来。
# 策略：先等它自愈（绝大多数改动根本不需要动手）；真没起来，才只补「接口名丢了」的那个模组。
recover_net() {
	_i=0
	while [ "$_i" -lt 8 ]; do
		_i=$((_i+1))
		sleep 4
		# 已经好了 → 直接返回，什么都不做
		ip link show rndis-modem1 >/dev/null 2>&1 && ip route 2>/dev/null | grep -q '^default' && return 0
		# 接口名丢了、但裸接口 usb0/usb1 在 → 就是重枚举后固件没改名，立刻修，不用再等
		if ! ip link show rndis-modem1 >/dev/null 2>&1 \
		   && { ip link show usb0 >/dev/null 2>&1 || ip link show usb1 >/dev/null 2>&1; }; then
			break
		fi
	done

	# 只补「接口名真的丢了」的那个模组；名字都在就不动它
	_fixed=0
	for _m in modem1 modem2; do
		if ! ip link show "rndis-$_m" >/dev/null 2>&1; then
			/usr/libexec/mifi-rndis.sh "$_m" >/dev/null 2>&1
			ifup "$_m" >/dev/null 2>&1
			_fixed=1
		fi
	done
	[ "$_fixed" -eq 0 ] && return 1
	sleep 6
	ip route 2>/dev/null | grep -q '^default'
}

# 一次会话发完所有命令，返回原始响应（已去 \r）
# flock：短信轮询守护与面板操作共用 AT 口，全局串行（防两个 picocom 会话互相污染）
at_query() {
	_p="$1"; shift
	# ★ 首选 fzs-atio：一次调用跑完整个会话，逐条握手（发一条 → 等到 OK/ERROR
	#   → 再发下一条），毫秒级超时。排空残留由它内部的 -d 200 完成，
	#   因此既不需要固定 sleep 盲等，也不需要"整轮重发"这种补偿手段。
	if [ -n "$ATIO_BIN" ]; then
		# ★★ 完整性校验 + 重试（2026-10-07 实测故障后加）：旧代码这里
		#   **只判断「输出非空」就 return 0** —— 后果静默且致命：某条命令超时
		#   （模组忙时常见，尤其刚发完短信的 EC200T）时，fzs-atio 会把它的响应
		#   drain 掉继续往下走；上层看到 raw 里**没有 `+CMGL`** → 误判「没有短信」
		#   → **短信明明躺在模组里却读不到**。真实故障：发完短信 1 分 42 秒后
		#   才收到回信（同一设备 EC200N 侧则很快）。
		#   ⚠️ 判据必须数「应答行」、不能只看退出码：实测 fzs-atio 在**完全读不到
		#   数据**时仍会返回 0（stdout 只有空行）。也**不能只数 OK**：没插卡时
		#   AT+CPMS? 返回 `+CME ERROR`，那是有效应答，数 OK 会误判成失败。
		_i=0
		_want=$((2 + $#))     # 期望应答数：2 = 开头的 AT + ATE0，$# = 命令数
		while [ "$_i" -lt 3 ]; do
			_i=$((_i+1))
			_buf=$( { flock 9
				{ printf 'AT\nATE0\n'; for _c in "$@"; do printf '%s\n' "$_c"; done; } \
					| "$ATIO_BIN" -t "$ATIO_TIMEOUT" -d 200 "/dev/$_p"
			} 9>/tmp/fzs-at-${_p}.lock )
			_ans=$(printf '%s\n' "$_buf" | grep -cE '^(OK|ERROR|\+CME ERROR|\+CMS ERROR)')
			# ★★ 判据 = **恰好等于期望值**（2026-10-07 晚 22:0x 收紧）：
			#   - 少于期望：有命令的应答丢了（模组忙）→ 重读；
			#   - **多于期望**：说明整份响应被读了两遍（实测 OK=10/CMGL=14，
			#     正常应 5/7）→ 数据不可信，**也必须重读**（否则同一条短信会重复入库）。
			#   旧判据是「≥ 期望」，把"多了"当成成功放过去，正是重复入库的入口。
			if [ "$_ans" = "$_want" ]; then
				printf '%s\n' "$_buf"
				return 0
			fi
			[ "$_i" -lt 3 ] && sleep 1
		done
		# ★★★ 2026-10-07 晚 22:4x 关键修复：三次重试都不满足时，
		#   **绝不再返回"可能翻倍"的脏数据**（原实现会把最后一次结果原样返回）。
		#
		#   实测证据（现场文件 `/tmp/fzs-sms/ANOMALY-143957-modem1.txt`）：
		#   模组忙（连 `AT` 都超时）时，`AT+CMGL=4` 的响应会**整份出现两遍** ——
		#   现场里 `+CPMS` 出现 2 次、`+CMGL` 索引序列是 `0..6` 然后又是 `0..6`；
		#   实测应答数 `OK=13`（正常应为 5）。拿这种数据去解析，
		#   后果 = **同一条短信入库两次**（实测症状：发一条、收件箱出现两条）
		#   + 长短信分片编号错乱、永远凑不齐（表现为"收信延迟上百秒"）。
		#
		#   取舍：**宁可本轮返回空（视为"没读到"），也不返回脏数据**。
		#   短信仍在模组里，**下一轮会再读到，不会丢**；而脏数据的代价是重复入库。
		#   （守护见空 raw 会跳过本轮解析，下轮继续。）
		if [ -n "$_buf" ]; then
			# 读到了数据但应答数始终不达标（很可能就是"整份翻倍"的脏数据）
			# → **丢弃，返回失败**。短信仍在模组里，下一轮会再读到，不会丢。
			return 1
		fi
		# 完全没读到任何应答 → 尝试回退工具（picocom/socat）
		if [ -z "$AT_TOOL" ]; then return 1; fi
		_buf=""
	fi
	# ---- 以下为回退路径（picocom / socat）----
	# ★ 排空上一会话残留：raw 模式下驱动不再替我们丢弃旧数据，上一次会话迟到的输出
	#   （例如轮询时一大段 +CMGL）会留在缓冲区里，被当成“本次结果”返回 → 解析出空值。
	#   先只读不写一小段时间，把它读干丢弃。
	if [ "$AT_TOOL" = picocom ]; then
		{ flock 9
		  { sleep 1; } | picocom -b 115200 -q --nolock --noreset "/dev/$_p" >/dev/null 2>&1
		} 9>/tmp/fzs-at-${_p}.lock
	fi
	_i=0
	while [ "$_i" -lt 3 ]; do
		_i=$((_i+1))
		# 开头 AT 热身 + ATE0 关回显：
		# 1) EC200T 的带星号命令（AT*BAND? / AT*CELL=）作会话首条约 10% 被拒，先发 AT 可降到 0
		# 2) ATE0 从源头消灭回显污染。注意：解析不依赖回显行（按内容解析）
		if [ "$AT_TOOL" = picocom ]; then
			_buf=$( { flock 9
				{ printf 'AT\r'; sleep 1
				  printf 'ATE0\r'; sleep 1
				  # ★ 分块发（每 3 条一批、间隔 1s）：模组一次性灌入一整串命令时，
				  #   前面几条会因接收缓冲溢出而被丢（实测：一整串 7 条时丢前 5 条）。
				  _k=0
				  for _c in "$@"; do
					printf '%s\r' "$_c"; _k=$((_k+1))
					[ $((_k % 3)) -eq 0 ] && sleep 1
				  done
				  sleep 2
				} | picocom -b 115200 -q --nolock --noreset "/dev/$_p" 2>/dev/null | tr -d '\r'
			} 9>/tmp/fzs-at-${_p}.lock )
		else
			_buf=$( { flock 9
				{ printf 'AT\rATE0\r'; for _c in "$@"; do printf '%s\r' "$_c"; done; sleep 2; } \
					| socat -T 2 - "/dev/$_p,raw,echo=0,b115200" 2>/dev/null | tr -d '\r'
			} 9>/tmp/fzs-at-${_p}.lock )
		fi
		# ★ 完整性校验：开端口后第一批命令有 30~50% 概率被整个丢掉
		#   （前代 mifi-at 实测：加大等待无效，只有重发才行）。
		#   正常应有 2（AT + ATE0）+ N（管道数）个 OK；不够就重发。
		_okc=$(printf '%s\n' "$_buf" | grep -c '^OK$')
		if [ "$_okc" -ge "$((2 + $#))" ]; then
			printf '%s\n' "$_buf"; return 0
		fi
		[ -n "$_buf" ] && _last="$_buf"
	done
	# 三次都不完整：最后一次的缓冲取实（能解出多少算多少）
	[ -n "$_last" ] && { printf '%s\n' "$_last"; return 0; }
	return 1
}

jesc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

emit_modem() {
	_t="$1"
	_p=$(target_to_port "$_t") || {
		printf '{"name":"%s","port":"","ok":false,"err":"找不到 AT 口"}' "$(target_name "$_t")"
		return 0
	}
	_buf=$(at_query "$_p" 'AT+CGSN' 'AT+CIMI' 'AT+QCCID' 'AT+QENG="servingcell"' 'AT+COPS?' 'AT+CEREG?') || {
		printf '{"name":"%s","port":"%s","ok":false,"err":"模组无响应"}' "$(target_name "$_t")" "$_p"
		return 0
	}
	# 解析不依赖命令回显行（ATE0 已关回显）：纯数字行第 1 条=IMEI、第 2 条=IMSI
	printf '%s\n' "$_buf" | awk -v name="$(target_name "$_t")" -v port="$_p" -v model="$(port_model "$_p")" '
		function esc(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return s }
		function num(s) { return (s ~ /^-?[0-9]+$/) ? s : "" }
		/^[0-9]+$/ { if (imei == "") { imei = $0; next } else if (imsi == "") { imsi = $0; next } }
		/^\+QCCID:/ { ccid = $2 }
		/^\+QENG:/ { qeng = $0 }
		/^\+COPS:/ { cops = $0 }
		/^\+CEREG:/ { cereg = $0 }
		END {
			if (imei == "" && qeng == "") {
				printf "{\"name\":\"%s\",\"port\":\"%s\",\"ok\":false,\"err\":\"本次读取失败，请点刷新重试\"}\n", esc(name), port
				exit
			}
			split(qeng, f, ",")
			st = f[2]; gsub(/"/, "", st)
			dx = f[4]; gsub(/"/, "", dx)
			op = ""
			if (match(cops, /"[^"]*"/)) op = substr(cops, RSTART + 1, RLENGTH - 2)
			r = "未知"
			if (cereg ~ /,/) {
				split(cereg, g, ",")
				v = g[2] + 0
				r = (v == 1 ? "已注册" : v == 2 ? "搜网中" : v == 3 ? "被拒" : v == 5 ? "漫游" : v == 0 ? "未注册" : "未知")
			}
			printf "{\"name\":\"%s\",\"port\":\"%s\",\"ok\":true,\"model\":\"%s\",\"imei\":\"%s\",\"iccid\":\"%s\",\"imsi\":\"%s\",\"state\":\"%s\",\"duplex\":\"%s\",\"band\":\"%s\",\"earfcn\":\"%s\",\"pci\":\"%s\",\"rsrp\":\"%s\",\"rsrq\":\"%s\",\"sinr\":\"%s\",\"operator\":\"%s\",\"reg\":\"%s\"}\n", \
				esc(name), port, model, imei, ccid, imsi, esc(st), esc(dx), \
				num(f[10]), num(f[9]), num(f[8]), num(f[14]), num(f[15]), num(f[17]), esc(op), r
		}
	'
	return 0
}

emit_all() {
	_want="$1"
	if [ -n "$_want" ]; then
		printf '['; emit_modem "$_want"; printf ']\n'
		return 0
	fi
	# 两个模组走不同 USB 口，内部并行读（比经 rpcd 发两次快得多）
	_t="/tmp/fzs-at.$$"
	emit_modem 1 > "$_t.1" 2>/dev/null &
	emit_modem 2 > "$_t.2" 2>/dev/null &
	wait
	printf '[%s,%s]\n' \
		"$(cat "$_t.1" 2>/dev/null || printf '{"ok":false}')" \
		"$(cat "$_t.2" 2>/dev/null || printf '{"ok":false}')"
	rm -f "$_t.1" "$_t.2"
}

imei_read_one() {
	_buf=$(at_query "$1" 'AT+CGSN') || return 1
	# ATE0 后无回显标记，第一条纯数字行即 IMEI
	printf '%s\n' "$_buf" | awk '/^[0-9]+$/ { print; exit }'
	return 0
}

imei_write_one() {
	_p="$1"; _imei="$2"
	at_query "$_p" 'AT*PROD=1' >/dev/null || return 1
	at_query "$_p" 'AT*MRD_IMEI=D' >/dev/null || return 1
	at_query "$_p" "AT*MRD_IMEI=W,0,01JAN1970,$_imei" >/dev/null || return 1
	at_query "$_p" 'AT*PROD=0' >/dev/null || return 1
	at_query "$_p" 'AT+RESET' >/dev/null
	sleep 15
	[ "$(imei_read_one "$_p")" = "$_imei" ]
}

# ---- 锁频段（AT*BAND）------------------------------------------------------
# AT*BAND 有 8 个值，只改第 4 位(TDD 掩码)与第 5 位(FDD 掩码)，其余原样回写。
# 位序：FDD 位号 = 频段-1；TDD 位号 = 频段-33。
FDD_BANDS="1 3 5 8"
TDD_BANDS="34 38 39 40 41"

band_read_raw() {
	_buf=$(at_query "$1" 'AT*BAND?') || return 1
	# 两个模组格式不同：EC200T 回 8 个值无空格，EC200N 回 10 个值带空格 → 统一去空格
	printf '%s\n' "$_buf" | sed -n 's/^[*]BAND: *//p' | head -1 | tr -d ' '
}

band_to_masks() {   # $1 = 逗号分隔频段列表 -> "tdd fdd"
	_tdd=0; _fdd=0
	for _b in $(printf '%s' "$1" | tr ',' ' '); do
		case " $FDD_BANDS " in *" $_b "*) _fdd=$((_fdd | (1 << (_b - 1)))) ;; esac
		case " $TDD_BANDS " in *" $_b "*) _tdd=$((_tdd | (1 << (_b - 33)))) ;; esac
	done
	printf '%s %s\n' "$_tdd" "$_fdd"
}

earfcn_to_band() {
	case "$1" in ''|*[!0-9]*) return 1 ;; esac
	_n="$1"
	if   [ "$_n" -le 599 ];   then echo 1
	elif [ "$_n" -ge 1200 ] && [ "$_n" -le 1949 ];  then echo 3
	elif [ "$_n" -ge 2400 ] && [ "$_n" -le 2649 ];  then echo 5
	elif [ "$_n" -ge 3450 ] && [ "$_n" -le 3799 ];  then echo 8
	elif [ "$_n" -ge 36200 ] && [ "$_n" -le 36349 ]; then echo 34
	elif [ "$_n" -ge 37750 ] && [ "$_n" -le 38249 ]; then echo 38
	elif [ "$_n" -ge 38250 ] && [ "$_n" -le 38649 ]; then echo 39
	elif [ "$_n" -ge 38650 ] && [ "$_n" -le 39649 ]; then echo 40
	elif [ "$_n" -ge 39650 ] && [ "$_n" -le 41589 ]; then echo 41
	else return 1
	fi
}

cmd_band_read() {
	_p=$(target_to_port "$1") || { printf '{"ok":false,"err":"找不到 AT 口"}\n'; return 0; }
	_cur=$(band_read_raw "$_p") || { printf '{"ok":false,"err":"模组无响应"}\n'; return 0; }
	[ -n "$_cur" ] || { printf '{"ok":false,"err":"该模组不支持读取频段配置"}\n'; return 0; }
	_tdd=$(printf '%s' "$_cur" | cut -d, -f4)
	_fdd=$(printf '%s' "$_cur" | cut -d, -f5)
	case "$_tdd" in ''|*[!0-9]*) _tdd=0 ;; esac
	case "$_fdd" in ''|*[!0-9]*) _fdd=0 ;; esac
	_list=""
	for _b in $FDD_BANDS; do
		[ $((_fdd & (1 << (_b - 1)))) -ne 0 ] && _list="$_list$_b,"
	done
	for _b in $TDD_BANDS; do
		[ $((_tdd & (1 << (_b - 33)))) -ne 0 ] && _list="$_list$_b,"
	done
	printf '{"ok":true,"tdd":%s,"fdd":%s,"bands":"%s"}\n' "$_tdd" "$_fdd" "${_list%,}"
}

cmd_band_write() {   # $1=目标 $2=频段列表（空 = 恢复出厂掩码）
	_tgt="$1"; _list="$2"
	_p=$(target_to_port "$_tgt") || die "找不到 $_tgt 的 AT 口"
	_cur=$(band_read_raw "$_p") || die "读不到当前频段配置，未做改动"
	[ -n "$_cur" ] || die "该模组不支持频段配置，未做改动"
	if [ -z "$_list" ]; then
		_tdd=482; _fdd=149
	else
		_masks=$(band_to_masks "$_list")
		_tdd=$(printf '%s' "$_masks" | cut -d' ' -f1)
		_fdd=$(printf '%s' "$_masks" | cut -d' ' -f2)
		[ "$_tdd" -eq 0 ] && [ "$_fdd" -eq 0 ] && die "没有可用的频段"
	fi
	# 只替换第 4(TDD) / 第 5(FDD) 位，其余位（含模组2 多出来的第 9、10 位）原样保留
	_new=$(printf '%s' "$_cur" | awk -v tdd="$_tdd" -v fdd="$_fdd" -F, '{
		for (i = 1; i <= NF; i++) { v = (i == 4) ? tdd : (i == 5) ? fdd : $i; printf "%s%s", (i > 1 ? "," : ""), v }
	}')
	_buf=$(at_query "$_p" "AT*BAND=$_new") || die "写入无响应"
	# 写入成功后模组会重新枚举，串口尾部的杂音里可能夹着 ERROR —— 必须先认 OK
	case "$_buf" in
	*OK*)
		_net=fail
		if recover_net; then _net=ok; fi
		printf '{"ok":true,"value":"%s","net":"%s"}\n' "$_new" "$_net"
		;;
	*ERROR*|*error*) printf '{"ok":false,"err":"模组拒绝了该频段组合"}\n' ;;
	*) printf '{"ok":false,"err":"模组无明确回应"}\n' ;;
	esac
}

# ---- 锁频点 / 锁小区（AT*CELL）---------------------------------------------
cmd_cell_read() {
	_p=$(target_to_port "$1") || { printf '{"ok":false,"err":"找不到 AT 口"}\n'; return 0; }
	_buf=$(at_query "$_p" 'AT+QENG="servingcell"') || { printf '{"ok":false,"err":"模组无响应"}\n'; return 0; }
	printf '%s\n' "$_buf" | awk '
		/^\+QENG/ { n = split($0, f, ","); printf "{\"ok\":true,\"band\":\"%s\",\"earfcn\":\"%s\",\"pci\":\"%s\"}\n", f[10], f[9], f[8]; exit }
		END { if (n == 0) printf "{\"ok\":false,\"err\":\"未驻网，读不到小区\"}\n" }
	'
}

cmd_cell_lock() {   # $1=目标 $2=earfcn [$3=pci]
	_tgt="$1"; _earfcn="$2"; _pci="$3"
	case "$_earfcn" in ''|*[!0-9]*) die "EARFCN 必须是数字" ;; esac
	[ -z "$_pci" ] || case "$_pci" in *[!0-9]*) die "PCI 必须是数字" ;; esac
	_p=$(target_to_port "$_tgt") || die "找不到 $_tgt 的 AT 口"
	_band=$(earfcn_to_band "$_earfcn") || die "EARFCN $_earfcn 不在本设备支持的频段范围内"
	if [ -n "$_pci" ]; then
		_cmd="AT*CELL=2,3,$_band,$_earfcn,$_pci"
	else
		_cmd="AT*CELL=1,3,$_band,$_earfcn"
	fi
	_buf=$(at_query "$_p" "$_cmd") || die "写入无响应"
	case "$_buf" in
	*OK*)
		_net=fail
		if recover_net; then _net=ok; fi
		printf '{"ok":true,"band":"%s","earfcn":"%s","pci":"%s","net":"%s"}\n' "$_band" "$_earfcn" "$_pci" "$_net"
		;;
	*ERROR*|*error*) printf '{"ok":false,"err":"模组拒绝了该锁定参数"}\n' ;;
	*) printf '{"ok":false,"err":"模组无明确回应"}\n' ;;
	esac
}

cmd_cell_unlock() {
	_p=$(target_to_port "$1") || die "找不到 AT 口的模组"
	_buf=$(at_query "$_p" 'AT*CELL=0') || die "写入无响应"
	case "$_buf" in
	*OK*)
		_net=fail
		if recover_net; then _net=ok; fi
		printf '{"ok":true,"net":"%s"}\n' "$_net"
		;;
	*ERROR*|*error*) printf '{"ok":false,"err":"解除失败"}\n' ;;
	*) printf '{"ok":false,"err":"模组无明确回应"}\n' ;;
	esac
}

cmd_ports() {
	printf '%-12s %-9s %s\n' 设备 vid:pid 型号
	for _d in /sys/class/tty/ttyUSB*; do
		[ -e "$_d" ] || continue
		_n="${_d##*/}"
		_r=$(readlink -f "$_d/device" 2>/dev/null)
		_dd=$(find_up "$_r" idProduct)
		_pid=$(cat "$_dd/idProduct" 2>/dev/null)
		case "$_pid" in
		$PID_EC200T) _m=EC200T ;; $PID_EC200N) _m=EC200N ;; *) _m='?' ;; esac
		_at=''
		# 实测哪个口真能通 AT（被 pppd 独占的口会 EAGAIN，不能只看路径）
		if probe_at "$_n"; then
			_at='  ★AT口'
		elif [ -n "$ATIO_BIN" ]; then
			_at='  (占用/无响应)'
		fi
		printf '%-12s %-9s %s%s\n' "/dev/$_n" "2c7c:$_pid" "$_m" "$_at"
	done
}

# ---- APN 与数据开关（/etc/config/mifi 的 UI 化）----------------------------
# 不写任何拨号/激活逻辑：写入走 uci，重激活一律复用固件自己的 mifi-rndis.sh / ifup。
# 定案见 docs/APN与数据开关-平台能力与设计定案.md
cfg_of() {
	case "$1" in
	1|modem1|ec200t|EC200T|t|T) echo modem1 ;;
	2|modem2|ec200n|EC200N|n|N) echo modem2 ;;
	*) return 1 ;;
	esac
}

apn_cfg_get() {   # $1=cfg $2=key $3=默认值
	_v=$(uci -q get "mifi.$1.$2" 2>/dev/null)
	[ -n "$_v" ] && { printf '%s' "$_v"; return 0; }
	printf '%s' "$3"
}

route_ok() {
	_dev=$(uci -q get "network.$1.device" 2>/dev/null)
	[ -n "$_dev" ] && ip route 2>/dev/null | grep -F "dev $_dev" >/dev/null
}

# 数据开关状态 = netifd 接口 up（正是 ifdown/ifup 控制的东西）。
# 不能用路由判断：43.0/24 链路路由和 static 默认路由在没数据时也在。
iface_up() {
	ubus -S call "network.interface.$1" status 2>/dev/null | grep -q '"up": *true'
}

netdev_present() {
	ip link show "rndis-$1" >/dev/null 2>&1
}

# 网卡名健在时直接重激活 PDP（十几秒）。网卡已改名后绝不能再跑 mifi-rndis.sh：
# 它只会找"未改名"的网卡，白等 60 秒后放弃（2026-10-06 实测踩坑）。
pdp_activate() {   # $1=port $2=apn → 0=拿到 IP
	at_query "$1" "AT+CGDCONT=1,\"IP\",\"$2\"" >/dev/null || return 1
	# 先停再起，确保 PDP 重建（与 mifi-rndis.sh 同参数同顺序）
	at_query "$1" 'AT+QNETDEVCTL=0,1,0' >/dev/null
	sleep 1
	at_query "$1" 'AT+QNETDEVCTL=2,1,1' >/dev/null || return 1
	_buf=$(at_query "$1" 'AT+CGCONTRDP') || return 1
	printf '%s\n' "$_buf" | grep -qE 'CGCONTRDP: 1,[0-9]+,"[^"]+","[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+"'
}

# 配置为 auto 时解析出具体 APN：优先探测赢家，否则候选第一个
apn_resolve() {
	_cfg="$1"; _apn=$(apn_cfg_get "$_cfg" apn auto)
	[ "$_apn" = auto ] && _apn=$(cat "/tmp/.mifi-apn-good-$_cfg" 2>/dev/null)
	[ -n "$_apn" ] && [ "$_apn" != auto ] || _apn=cmiot
	printf '%s' "$_apn"
}

apn_read_one() {
	_cfg="$1"; _tn="${_cfg#modem}"
	_apn=$(apn_cfg_get "$_cfg" apn auto)
	_link=$(apn_cfg_get "$_cfg" link rndis)
	_good=$(cat "/tmp/.mifi-apn-good-$_cfg" 2>/dev/null)
	_act=""; _ip=""; _err=""
	_p=$(target_to_port "$_tn")
	if [ -n "$_p" ]; then
		_buf=$(at_query "$_p" 'AT+CFUN?' 'AT+CGCONTRDP')
		_cfun=$(printf '%s\n' "$_buf" | sed -n 's/^+CFUN: \([01]\)$/\1/p' | head -1)
		[ -n "$_cfun" ] || _cfun=1
		# 行形如 +CGCONTRDP: 1,5,"cmiot","10.x.x.x",...（地址字段可能带掩码尾巴，只取 IPv4）
		set -- $(printf '%s\n' "$_buf" | awk -F'"' '/^\+CGCONTRDP: 1,/ {
			ip = $4
			if (match(ip, /[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/)) ip = substr(ip, RSTART, RLENGTH); else ip = ""
			print $2, ip; exit
		}')
		_act="$1"; _ip="$2"
		[ -n "$_act" ] || _err="未激活 PDP"
	else
		_err="找不到 AT 口"
		_cfun="?"
	fi
	_data=off
	iface_up "$_cfg" && _data=on
	printf '{"name":"%s","cfg":"%s","ok":true,"apn_cfg":"%s","apn_good":"%s","apn_act":"%s","ip":"%s","link":"%s","data":"%s","cfun":"%s","err":"%s"}\n' \
		"$(target_name "$_tn")" "$_cfg" "$(jesc "$_apn")" "$(jesc "$_good")" \
		"$(jesc "$_act")" "$_ip" "$_link" "$_data" "$_cfun" "$(jesc "$_err")"
}

apn_read_all() {
	if [ -n "$1" ]; then
		_c=$(cfg_of "$1") || die "未知目标: $1"
		apn_read_one "$_c"
		return 0
	fi
	_t="/tmp/fzs-apn.$$"
	apn_read_one modem1 > "$_t.1" 2>/dev/null &
	apn_read_one modem2 > "$_t.2" 2>/dev/null &
	wait
	printf '[%s,%s]\n' "$(cat "$_t.1" 2>/dev/null)" "$(cat "$_t.2" 2>/dev/null)"
	rm -f "$_t.1" "$_t.2"
}

data_bring_up() {   # $1=cfg，按 link 走固件路径
	_cfg="$1"
	_link=$(apn_cfg_get "$_cfg" link rndis)
	if [ "$_link" = ppp ]; then
		ifup "$_cfg" >/dev/null 2>&1
		return 0
	fi
	if netdev_present "$_cfg"; then
		# 网卡健在：PDP 不在才激活；在就什么都不做，只补 ifup
		_p=$(target_to_port "${_cfg#modem}")
		if [ -n "$_p" ] && ! pdp_activate "$_p" "$(apn_resolve "$_cfg")"; then
			return 1
		fi
		ifup "$_cfg" >/dev/null 2>&1
		return 0
	fi
	# 网卡名丢了（模组重枚举过）→ 走固件完整路径（改名+bind 救活都在里面）
	/usr/libexec/mifi-rndis.sh "$_cfg" >/dev/null 2>&1
	ifup "$_cfg" >/dev/null 2>&1
}

cmd_apn_write() {   # $1=cfg $2=apn
	_cfg="$1"; _apn="$2"
	case "$_apn" in ''|*[!a-zA-Z0-9._-]*) die "APN 只能含字母数字和 . _ -" ;; esac
	uci -q set "mifi.$_cfg.apn=$_apn" || die "写配置失败"
	uci -q commit mifi || die "提交配置失败"
	_link=$(apn_cfg_get "$_cfg" link rndis)
	if [ "$_link" = ppp ]; then
		ifdown "$_cfg" >/dev/null 2>&1
		sleep 3
		ifup "$_cfg" >/dev/null 2>&1
		printf '{"ok":true,"cfg":"%s","apn":"%s","link":"ppp","net":"wait"}\n' "$_cfg" "$_apn"
		return 0
	fi
	if netdev_present "$_cfg"; then
		_p=$(target_to_port "${_cfg#modem}")
		[ -n "$_p" ] || { printf '{"ok":true,"cfg":"%s","apn":"%s","link":"rndis","net":"fail","err":"找不到 AT 口，点启用数据可重试"}\n' "$_cfg" "$_apn"; return 0; }
		if pdp_activate "$_p" "$_apn"; then
			ifup "$_cfg" >/dev/null 2>&1
			_net=fail
			route_ok "$_cfg" && _net=ok
			printf '{"ok":true,"cfg":"%s","apn":"%s","link":"rndis","net":"%s"}\n' "$_cfg" "$_apn" "$_net"
		else
			printf '{"ok":true,"cfg":"%s","apn":"%s","link":"rndis","net":"fail","err":"模组没接受这个 APN（没拿到 IP），改回 auto 或原值再应用即可恢复"}\n' "$_cfg" "$_apn"
		fi
		return 0
	fi
	/usr/libexec/mifi-rndis.sh "$_cfg" >/dev/null 2>&1
	ifup "$_cfg" >/dev/null 2>&1
	_net=fail
	route_ok "$_cfg" && _net=ok
	printf '{"ok":true,"cfg":"%s","apn":"%s","link":"rndis","net":"%s"}\n' "$_cfg" "$_apn" "$_net"
}

cmd_data_off() {   # $1=cfg
	_cfg="$1"
	_p=$(target_to_port "${_cfg#modem}")
	[ -n "$_p" ] && at_query "$_p" 'AT+QNETDEVCTL=0,1,0' >/dev/null
	ifdown "$_cfg" >/dev/null 2>&1
	printf '{"ok":true,"cfg":"%s","data":"off"}\n' "$_cfg"
}

cmd_data_on() {   # $1=cfg
	_cfg="$1"
	data_bring_up "$_cfg"
	_net=fail
	route_ok "$_cfg" && _net=ok
	printf '{"ok":true,"cfg":"%s","data":"on","net":"%s"}\n' "$_cfg" "$_net"
}

# ---- 飞行模式（AT+CFUN，射频全关；硬件已被固件 SIM 自愈验证安全）-----------
cmd_fun_off() {   # $1=cfg
	_cfg="$1"
	_p=$(target_to_port "${_cfg#modem}") || die "找不到 AT 口"
	_buf=$(at_query "$_p" 'AT+CFUN=0') || die "写入无响应"
	case "$_buf" in
	*OK*) ifdown "$_cfg" >/dev/null 2>&1; printf '{"ok":true,"cfg":"%s","cfun":"off"}\n' "$_cfg" ;;
	*ERROR*|*error*) printf '{"ok":false,"err":"模组拒绝了飞行模式"}\n' ;;
	*) die "模组无明确回应" ;;
	esac
}

cmd_fun_on() {   # $1=cfg
	_cfg="$1"
	_p=$(target_to_port "${_cfg#modem}") || die "找不到 AT 口"
	_buf=$(at_query "$_p" 'AT+CFUN=1') || die "写入无响应"
	case "$_buf" in
	*OK*) ;;
	*ERROR*|*error*) printf '{"ok":false,"err":"模组拒绝退出飞行模式"}\n'; return 0 ;;
	*) die "模组无明确回应" ;;
	esac
	# 等重新驻网（最多约 45 秒），驻网后再拉数据通路
	_i=0
	while [ "$_i" -lt 15 ]; do
		sleep 3
		_g=$(at_query "$_p" 'AT+CGATT?')
		case "$_g" in *"+CGATT: 1"*) break ;; esac
		_i=$((_i + 1))
	done
	data_bring_up "$_cfg" >/dev/null 2>&1
	_net=fail
	route_ok "$_cfg" && _net=ok
	printf '{"ok":true,"cfg":"%s","cfun":"on","net":"%s"}\n' "$_cfg" "$_net"
}

# ---- 短信（Phase 1：收发主体；PDU 读 / 文本+UCS2 发）------------------------
# 读走 PDU 模式（文本模式拿不到长短信 UDH 拼接信息），解析在 fzs-sms.uc
cmd_sms_list() {
	_p=$(target_to_port "$1") || die "找不到 AT 口"
	# ★ 末尾两条是"注册态"，供守护判断要不要降频轮询（见 fzs-smsd）：
	#   AT+CREG? = CS 域（EC200T 的短信走这里）、AT+CEREG? = PS 域（EC200N 走 IMS/PS）。
	#   追加在同一个会话里 ⇒ 不额外起进程、不额外开串口，实测只多 ~23ms（120→143ms）。
	at_query "$_p" 'AT+CMGF=0' 'AT+CPMS?' 'AT+CMGL=4' 'AT+CREG?' 'AT+CEREG?'
}

cmd_sms_delete() {   # $1=目标 $2=索引
	case "$2" in ''|*[!0-9]*) die "索引必须是数字" ;; esac
	_p=$(target_to_port "$1") || die "找不到 AT 口"
	_buf=$(at_query "$_p" "AT+CMGD=$2") || die "写入无响应"
	case "$_buf" in
	*OK*) printf '{"ok":true}\n' ;;
	*ERROR*|*error*) printf '{"ok":false,"err":"删除失败（索引可能已失效）"}\n' ;;
	*) printf '{"ok":false,"err":"模组无明确回应"}\n' ;;
	esac
}   # end cmd_sms_delete

cmd_sms_delmulti() {   # $1=目标 $2=索引列表（逗号分隔，如 "1,3,5"）——批量删除已入库条目
	_p=$(target_to_port "$1") || die "找不到 AT 口"
	_list=$(printf '%s' "$2" | tr ',' ' ')
	_cmds=""
	for _i in $_list; do
		case "$_i" in ''|*[!0-9]*) continue ;; esac
		_cmds="$_cmds AT+CMGD=$_i"
	done
	[ -n "$_cmds" ] || { printf '{"ok":true,"deleted":0}\n'; return 0; }
	# at_query 支持多命令一次会话发完（$_cmds 有意不加引号 → 按空格拆成多个参数）
	_buf=$(at_query "$_p" $_cmds) || die "删除无响应"
	case "$_buf" in
	*OK*) printf '{"ok":true}\n' ;;
	*) printf '{"ok":false,"err":"部分删除失败"}\n' ;;
	esac
}

cmd_sms_drop() {   # $1=目标 $2=索引 → 从收件箱记录移除；并尽力删除存储里的副本
	# 记录移除优先（自动清理开启时该条可能已不在存储里，但记录必须能删掉）
	( flock 9; UC_SUB=drop UC_ARG1="$1" UC_ARG2="$2" ucode /usr/libexec/fzs-sms.uc ) 9>/tmp/fzs-sms-state.lock
	_p=$(target_to_port "$1") 2>/dev/null
	[ -n "$_p" ] && at_query "$_p" "AT+CMGD=$2" >/dev/null 2>&1
}

# native_ims_target [ims-bypass] 2026-10-21
#   回显第一个"有卡 且 模组原生 IMS 栈已注册"的 target(1|2); 都不满足则空。
#   用途: EC200N 等固件自带 IMS 的模组, 短信走原生 AT+CMGS 即走 IMS 域, 无需 imsengine;
#         而 EC200T(AT+QCFG="ims" → +CME ERROR: 4)没有 IMS 栈, 才必须走引擎。
#   判据: AT+CPIN? → READY  且  AT+CIREG? → <n>,1
native_ims_target() {
	local _t _p _st
	for _t in 1 2; do
		_p=$(target_to_port "$_t") 2>/dev/null
		[ -n "$_p" ] || continue
		at_query "$_p" 'AT+CPIN?' 2>/dev/null | grep -q 'READY' || continue
		# 注意: .*$ 必须带, 否则 +CIREG: 1,1,15 会残留成 "1,15" 而匹配不上
		_st=$(at_query "$_p" 'AT+CIREG?' 2>/dev/null | tr -d '\r' \
			| sed -n 's/^+CIREG: *[0-9]*,\([0-9]*\).*$/\1/p' | head -1)
		[ "$_st" = "1" ] && { echo "$_t"; return 0; }
	done
	return 1
}

# cmd_ims_native [ims-bypass]: 输出 "<target> <at口绝对路径>"; 无原生 IMS 则退出 1
cmd_ims_native() {
	local _t _p
	_t=$(native_ims_target) || return 1
	_p=$(target_to_port "$_t") || return 1
	echo "$_t /dev/$_p"
}

cmd_sms_send() {   # $1=目标 $2=号码 $3=内容
	# ── IMS 通道 [ims-bridge] v3（imsengine，2026-10-20 接入）─────────────
	#   EC200T 的模组固件**不含 IMS/VoLTE 协议栈**（AT+QCFG="ims" → +CME ERROR: 4），
	#   它的原生短信只能走 CS 域：收信慢甚至收不到，发信还会撞 CMS 304/500
	#   （下面 die "被模组拒绝（CMS 错误 …）" 就是这条路径）。
	#   自研 imsengine 在用户态实现了 IMS（SIP MESSAGE over IP，走 cid3 数据通道），
	#   所以把面板发送统一改走 IMS：
	#     目标 ims / 1(EC200T) → /usr/libexec/ims-submit（用 200T 那张卡的 IMS 注册）
	#     目标 2(EC200N)       → 保留原生 AT+CMGS（EC200N 固件自带 IMS 栈，原生短信本来就正常）
	# ★ 2026-10-21 [ims-bypass]: 自带 IMS 栈的模组旁路引擎
	_tgt="$1"
	case "$1" in
		ims|1)
			_nt=$(native_ims_target 2>/dev/null)
			if [ -n "$_nt" ]; then
				# 该模组固件自带 IMS 且已注册 → 直接用它的原生通道（模组内部即走 IMS 域）
				_tgt="$_nt"
			elif [ -x /usr/libexec/ims-submit ] || [ -x /etc/init.d/ims ]; then
				# 引擎发成功就返回；失败（如未注册）则降级原生，不至于彻底发不出
				#
				# ★ 2026-10-30 改走 /usr/libexec/ims-submit，不再调 /etc/init.d/ims：
				#   rc.common 执行**任何**子命令前都要拿 procd_lock
				#   (/var/lock/procd_ims.lock)，而 start_service 探测 IMS 端口会遍历
				#   6 个串口（每口 -t 2500 且带 3 次重试，最坏 45s+），整段时间持锁。
				#   实测后果：ims start 卡住时，submit 在 flock 上无限阻塞，面板一直
				#   转圈、短信永远发不出。发短信只是投请求文件，不需要跟启停串行。
				if [ -x /usr/libexec/ims-submit ]; then
					/usr/libexec/ims-submit "$2" "$3"
				else
					/etc/init.d/ims submit "$2" "$3"     # 旧版兜底
				fi && {
					printf '{"ok":true,"chunks":1}\n'
					exit 0
				}
				_tgt="1"
			fi
			;;
	esac
	_num="$2"; _txt="$3"
	case "$_num" in ''|*[!0-9+]*) die "号码只能含数字和 +" ;; esac
	[ -n "$_txt" ] || die "内容不能为空"
	_p=$(target_to_port "$_tgt") || die "找不到 AT 口"
	# ★ 纯 PDU 模式发送（2026-10-07 晚 定案，取代此前的“文本模式 + 填充补偿”）：
	#   真因纠正：以前 PDU 报 CMS 304 / 文本带前缀，根因不在模组而在传输层——
	#   picocom 带了 --noinit，端口没被设成 raw、ECHO 一直开着，
	#   模组自己的 '>' 提示符被回显回自己，既污染正文（前缀）又污染 PDU 缓冲（→ CMS 304）。
	#   去掉 --noinit 后，纯 PDU 发送一次通过、内容零多余字符（10086 引用逐一核对）。
	#   同设备前代固件（FZS-SMSForwarder）N 槽正是这么做：只发 PDU，不设 CSCS/CSMP。
	#   实现：CMGF=0 + AT+CMGS=<TPDU字节数> + <PDU hex> + Ctrl-Z（等 '>' 提示符后再给 PDU）
	_plan=$(UC_SUB=pdu UC_ARG1="$_num" UC_ARG2="$_txt" ucode /usr/libexec/fzs-sms.uc) || die "PDU 编码失败"
	[ -n "$_plan" ] || die "PDU 编码失败"
	_i=0
	exec 9>/tmp/fzs-at-${_p}.lock
	flock 9
	while read -r _len _pdu; do
		_i=$((_i + 1))
		[ -n "$_pdu" ] || continue
		_cap=/tmp/fzs-sms/.send
		: > "$_cap"
		if [ -n "$ATIO_BIN" ]; then
			# ★ 首选 fzs-atio：内部按 "AT → ATE0 → CMGF=0 → CMGS=<len>（等 '>'）
			#   → PDU + Ctrl-Z" 逐条握手，毫秒级超时。
			#   取代老方案的固定 sleep 2+3+8 = 13.5 秒。
			"$ATIO_BIN" -t "$ATIO_TIMEOUT" -d 200 -m sms "/dev/$_p" "$_len" "$_pdu" > "$_cap" 2>/dev/null
		else
			{ printf 'AT\rATE0\rAT+CMGF=0\r'
			  sleep 2
			  printf 'AT+CMGS=%s\r' "$_len"
			  sleep 3
			  printf '%s\x1A' "$_pdu"
			  sleep 8
			} | picocom -b 115200 -q --nolock --noreset "/dev/$_p" > "$_cap" 2>/dev/null
		fi
		grep -q '+CMGS:' "$_cap" || {
			_c=$(grep -o '+CMS ERROR: *[0-9]*' "$_cap" 2>/dev/null | grep -o '[0-9]*$' | head -1)
			[ -n "$_c" ] && die "第 ${_i} 条被模组拒绝（CMS 错误 ${_c}）"
			die "第 ${_i} 条发送未获模块确认（响应见 $_cap）"
		}
	done <<EOF
$_plan
EOF
	UC_SUB=outbox UC_ARG1="$_tgt" UC_ARG2="$_num" UC_ARG3="$_txt" ucode /usr/libexec/fzs-sms.uc
	printf '{"ok":true,"chunks":%s}\n' "$_i"
}

cmd_sms_inbox() {
	UC_SUB=inbox ucode /usr/libexec/fzs-sms.uc
}

cmd_sms_csca() {   # $1=目标 → 输出短信中心号码（如 +8613800757500），读不到输出空
	_p=$(target_to_port "$1") || return 0
	# CSCS="IRA" 复位：文本模式发送残留的 CSCS=UCS2 会让 CSCA? 回 UCS2 hex（实测踩过）
	_buf=$(at_query "$_p" 'AT+CSCS="IRA"' 'AT+CSCA?') || return 0
	_s=$(printf '%s\n' "$_buf" | sed -n 's/.*+CSCA: *"\([^"]*\)".*/\1/p' | head -1)
	[ -n "$_s" ] || return 0
	UC_SUB=cscadec UC_ARG1="$_s" ucode /usr/libexec/fzs-sms.uc 2>/dev/null || printf '%s\n' "$_s"
}

# ── IMS 引擎对接（2026-10-20）──────────────────────────────────────────────
# cmd_ims_learn: P-CSCF 自学习。卡必须已插在模组2(EC200N) 上。
#   引擎 imsengine learn 会：开 200N 的原生 IMS → 读 AT+CGCONTRDP 的
#   P_CSCF_prim/sec → 按「同卡精确 + 运营商前缀兜底」写 /etc/pcscf_learned.json。
#   输出透传（本身是 JSON）；非 JSON 的异常输出包装成 {"ok":false,...}。
cmd_ims_learn() {   # $1=学习源 AT 口（可选, 省略自动探测）
	if [ ! -x /etc/init.d/ims ]; then
		printf '{"ok":false,"err":"未安装 imsengine 插件（/etc/init.d/ims 不存在）"}\n'
		return 1
	fi
	_r=$(/etc/init.d/ims learn "$1" 2>&1)
	_rc=$?
	case "$_r" in
	\{*\})
		printf '%s\n' "$_r"
		;;
	*)
		_e=$(printf '%s' "$_r" | tr '\r\n' '  ' | sed 's/\\/\\\\/g; s/"/\\"/g')
		[ -n "$_e" ] || _e="学习失败（无输出, rc=$_rc）"
		printf '{"ok":false,"err":"%s"}\n' "$_e"
		;;
	esac
	return $_rc
}

