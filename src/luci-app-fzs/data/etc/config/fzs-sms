config sms 'globals'
	# 短信中心总开关。1 = 开启（默认）；0 = 完全关闭：不再后台轮询短信，也不再收短信。
	#   只影响短信功能，锁频段 / 改串 / APN / 概览等不受影响。
	option enabled '1'
	# 轮询间隔（秒）。两个模组并行读取，每轮约 0.8 秒；间隔越小，收到短信越快。
	#   2 = 收信延迟约 1~2 秒（当前默认，最快）；调大更省 CPU/串口。
	option interval '2'
	# 模组未注册时的轮询间隔（秒）。卡没注册时收不到新短信，此时自动降频省 CPU；
	#   注册恢复后，最多等这么久就自动回到上面的 interval。
	option idle_interval '20'
	option modem1 '1'
	option modem2 '1'
	# 短信存储位置：默认只存设备上（空间大、能存 500 条、满了自动清最旧的、不会丢）。
	#   0 = 只存设备上（推荐）：收到后自动清掉模块/SIM 里的副本，防止卡满拒收新短信
	#   1 = 额外在 SIM 卡上也保存一份（注意：SIM 卡通常只能存 50 条，卡满后会收不到新短信）
	option keep_in_storage '0'
	# ---- 短信转发（PushPlus / Bark / 通用 webhook）----
	option fwd_enabled '0'
	# 渠道列表，逗号分隔：pushplus / bark / webhook
	option fwd_channels ''
	# 转发哪些模组：1 = 转，0 = 不转。默认两个都转。
	#   只想转某一个模组时，把另一个设为 0 即可（两个都是 0 = 不转发）。
	option fwd_modem1 '1'
	option fwd_modem2 '1'
	option fwd_title '短信转发'
	# PushPlus（微信推送）https://www.pushplus.plus 的 token
	option fwd_pushplus_token ''
	# Bark（iPhone）https://api.day.app 的 key
	option fwd_bark_key ''
	# 通用 webhook：会以 POST 方式发送 JSON {"sender","time","content"}
	option fwd_webhook_url ''
	# ---- 以下为 2026-10-07 晚新增渠道（格式均照各家官方文档：POST + JSON）----
	# 企业微信·群机器人 Webhook
	#   https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
	option fwd_wecom_webhook ''
	# 钉钉·群机器人 Webhook（https://oapi.dingtalk.com/robot/send?access_token=xxx）
	option fwd_dingtalk_webhook ''
	# 钉钉安全设置为「自定义关键词」时，把那个词填这里（会拼到消息最前面）
	option fwd_dingtalk_keyword ''
	# 飞书·群机器人 Webhook
	#   https://open.feishu.cn/open-apis/bot/v2/hook/xxx
	option fwd_feishu_webhook ''
	# Telegram 机器人（@BotFather 获得的 Token）
	option fwd_tg_token ''
	# Telegram 接收会话 ID
	option fwd_tg_chatid ''
	# Telegram API 反代域名（国内网络必填；留空=api.telegram.org）
	option fwd_tg_apihost ''
