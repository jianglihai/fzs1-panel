#!/bin/sh /etc/rc.common
# fzs-sms —— 短信轮询守护服务
USE_PROCD=1
START=95

# ★ 短信中心总开关（uci: fzs-sms.globals.enabled，默认 1=开）。
#   关闭时**不启动**守护 —— 不需要短信的用户（如插物联卡的）可彻底停掉，零占用。
#   影响面只有短信：锁频段 / 改串 / APN / 概览等是独立的 AT 操作，照常可用。
sms_enabled() {
	local v
	config_load fzs-sms 2>/dev/null
	config_get v globals enabled 1
	[ "$v" = "0" ] && return 1
	return 0
}

start_service() {
	sms_enabled || return 0
	procd_open_instance
	procd_set_param command /usr/libexec/fzs-smsd
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
