				"/usr/libexec/fzs-at * * *": [ "exec" ],
				"/usr/libexec/fzs-at * * * *": [ "exec" ],
				"/usr/libexec/fzs-net": [ "exec" ],
				"/usr/libexec/fzs-net *": [ "exec" ],
				"/usr/libexec/fzs-net * *": [ "exec" ],
				"/usr/libexec/fzs-net * * *": [ "exec" ],
				"/usr/libexec/fzs-net * * * *": [ "exec" ],
				"/sbin/uci": [ "exec" ],
				"/sbin/uci *": [ "exec" ],
				"/sbin/uci * *": [ "exec" ],
				"/sbin/uci * * *": [ "exec" ],
				"/sbin/uci * * * *": [ "exec" ],
				"/etc/init.d/fzs-sms": [ "exec" ],
				"/etc/init.d/fzs-sms *": [ "exec" ]
			},
			"uci": [ "fzs-sms" ]
		}
	}
}
