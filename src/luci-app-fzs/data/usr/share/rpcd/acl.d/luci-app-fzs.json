{
	"luci-app-fzs": {
		"description": "蜂助手面板：读取 4G 模组信息、修改 IMEI",
		"read": {
			"file": {
				"/usr/libexec/fzs-at": [ "exec" ],
				"/usr/libexec/fzs-at *": [ "exec" ],
				"/usr/libexec/fzs-at * *": [ "exec" ],
				"/usr/libexec/fzs-at * * *": [ "exec" ],
				"/usr/libexec/fzs-at * * * *": [ "exec" ],
				"/usr/libexec/fzs-net": [ "exec" ],
				"/usr/libexec/fzs-net *": [ "exec" ],
				"/usr/libexec/fzs-net * *": [ "exec" ],
				"/usr/libexec/fzs-net * * *": [ "exec" ],
				"/usr/libexec/fzs-net * * * *": [ "exec" ],
				"/sbin/uci": [ "exec" ],
				"/sbin/uci *": [ "exec" ],
				"/sbin/uci * *": [ "exec" ],
				"/sbin/uci * * *": [ "exec" ],
				"/sbin/uci * * * *": [ "exec" ],
				"/etc/init.d/fzs-sms": [ "exec" ],
				"/etc/init.d/fzs-sms *": [ "exec" ],
				"/usr/lib/opkg/info/luci-app-fzs.control": [ "read" ]
			},
			"uci": [ "fzs-sms" ]
		},
		"write": {
			"file": {
				"/usr/libexec/fzs-at": [ "exec" ],
				"/usr/libexec/fzs-at *": [ "exec" ],
