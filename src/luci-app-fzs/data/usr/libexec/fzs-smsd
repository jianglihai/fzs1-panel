#!/bin/sh
# fzs-smsd —— 短信轮询守护
#   1) 双卡轮询 → 解码入库（收件箱持久化在 /etc/fzs-sms，重启不丢）
#   2) 入库后自动从 SIM/模组删除（防存储积满 → 拒收新短信）；可用 uci keep_in_storage=1 关闭
#   3) 新短信逐条转发（PushPlus / Bark / 通用 webhook），失败重试上限 3 次后转入 fwdq-failed
#   4) ★ 每轮「读两个模组」由 fzs-atio 的**批量模式一次调用**完成（一个进程读全部模组），
#      而不是每模组后台起一条 `fzs-at sms list` —— 后者每轮 ≈38 个进程，
#      2 秒一轮会把这台单核机器拖到 14~16% CPU（详见循环 ① 处注释）。
#   5) ★ 注册态门控：模组"未注册"时降频到 idle_interval（默认 20 秒）。
#      未注册就收不到新短信，但模组存储里可能还压着旧短信、也必须有人发现"何时恢复注册"，
#      所以是**降频而不是停**。判据与兜底见 reg_should_read / reg_mark。
mkdir -p /etc/fzs-sms /etc/fzs-sms/fwdq /tmp/fzs-sms

# ★ 短信轮询的命令清单 —— 供 fzs-atio 的批量模式（-b）读取。
#   必须与 fzs-at 里 cmd_sms_list 的命令序列**完全一致**（改一处要同步另一处）；
#   会话前导的 AT / ATE0 由引擎自己发，不写在这里。
printf 'AT+CMGF=0\nAT+CPMS?\nAT+CMGL=4\nAT+CREG?\nAT+CEREG?\n' > /tmp/fzs-sms/cmds.txt

# 首次升级迁移：旧版状态在 /tmp（内存盘），搬一次到持久目录（只搬缺失的）
for f in inbox.jsonl outbox.jsonl; do
	[ -f "/tmp/fzs-sms/$f" ] && [ ! -f "/etc/fzs-sms/$f" ] && cp "/tmp/fzs-sms/$f" "/etc/fzs-sms/$f"
done
for cfg in modem1 modem2; do
	for p in seen parts usage; do
		[ -f "/tmp/fzs-sms/$p-$cfg" ] && [ ! -f "/etc/fzs-sms/$p-$cfg" ] && cp "/tmp/fzs-sms/$p-$cfg" "/etc/fzs-sms/$p-$cfg"
	done
done

interval=2
idle_interval=20
keep=0
fwd_enabled=0
fwd_channels=''
[ -f /lib/functions.sh ] && . /lib/functions.sh
if [ -f /etc/config/fzs-sms ]; then
	config_load fzs-sms
	config_get interval globals interval 2
	config_get idle_interval globals idle_interval 20
	config_get keep globals keep_in_storage 0
	config_get fwd_enabled globals fwd_enabled 0
	config_get fwd_channels globals fwd_channels ''
fi
case "$interval" in ''|*[!0-9]*) interval=2 ;; esac
[ "$interval" -lt 2 ] && interval=2
case "$idle_interval" in ''|*[!0-9]*) idle_interval=20 ;; esac
[ "$idle_interval" -lt "$interval" ] && idle_interval="$interval"
[ "$idle_interval" -gt 300 ] && idle_interval=300
# ★ 2026-10-07 晚 22:5x：删除了 FAST / ACTIVE_TTL 两档自适应（详见循环尾部说明）。
FWDQ=/etc/fzs-sms/fwdq
FWDFAIL=/etc/fzs-sms/fwdq-failed

# ★ 把 ucode 脚本预编译成字节码：两个模组每轮都要跑一次 ucode，而解释器每次
#   都要解析 26KB 源码（实测 144ms/次）；用设备自带的 ucc 编译后只要 98ms（省 32% CPU）。
#   编译失败就退回源码，功能不受影响。
UC_SMS=/usr/libexec/fzs-sms.uc
if ucc -c -o /tmp/fzs-sms.uc.bin "$UC_SMS" 2>/dev/null && [ -s /tmp/fzs-sms.uc.bin ]; then
	UC_SMS=/tmp/fzs-sms.uc.bin
fi

# 转发执行器 —— 渠道逻辑集中在 /usr/libexec/fzs-fwd（与页面「发送测试」共用同一套代码）
fwd_do() {   # $1=发件人 $2=时间 $3=正文 → 0=至少一个渠道成功
	/usr/libexec/fzs-fwd "$1" "$2" "$3"
}

# 处理转发队列
fwd_flush() {
	[ -d "$FWDQ" ] || return 0
	# 不转发的情形（一律丢弃队列，避免重新开启时把旧短信一股脑发出去）：
	#   ① 总开关关  ② 没勾任何渠道  ③ 两个模组都不勾（等于不转发）
	if [ "$fwd_enabled" != "1" ] || [ -z "$fwd_channels" ]; then
		rm -f "$FWDQ"/* 2>/dev/null
		return 0
	fi
	if [ "$fwd_modem1" != "1" ] && [ "$fwd_modem2" != "1" ]; then
		rm -f "$FWDQ"/* 2>/dev/null
		return 0
	fi
	_n=0
	for _f in "$FWDQ"/*; do
		[ -f "$_f" ] || continue
		_n=$((_n + 1))
		[ "$_n" -le 10 ] || break     # 单轮上限，避免队列过长拖慢轮询
		# ★ 按模组筛选（可只转某个模组）。
		#   队列文件名格式 = <ts>-<模组号>-<idx>，模组号取自 fzs-sms.uc 写入时的
		#   `substr(m.modem, 5)`（"modem1" → "1"）。这里取第 2 个字段比对即可，
		#   **无需改动上层写入逻辑**。
		#   不转发该模组的消息 → 直接删除（与"未启用转发"同样的处理：不留、不重试）。
		_fm=$(basename "$_f" | cut -d- -f2)
		case "$_fm" in
		1) [ "$fwd_modem1" = "1" ] || { rm -f "$_f" 2>/dev/null; continue; } ;;
		2) [ "$fwd_modem2" = "1" ] || { rm -f "$_f" 2>/dev/null; continue; } ;;
		esac
		_s=$(sed -n '1p' "$_f" 2>/dev/null)
		_t=$(sed -n '2p' "$_f" 2>/dev/null)
		_c=$(tail -n +3 "$_f" 2>/dev/null)
		if fwd_do "$_s" "$_t" "$_c"; then
			rm -f "$_f"
		else
			# 失败计数（文件名后缀 .rN），到 3 次转入 fwdq-failed 不再重试
			case "$_f" in
			*.r3)
				mkdir -p "$FWDFAIL"
				mv "$_f" "$FWDFAIL/" 2>/dev/null
				# ★ 上限保护：只留最近 100 条。转发失败的短信会永久堆在这里，
				#   长期运行必须封顶，否则几年下来是无底洞。
				if [ "$(ls "$FWDFAIL" 2>/dev/null | wc -l)" -gt 100 ]; then
					ls -t "$FWDFAIL" 2>/dev/null | tail -n +101 | while read -r _old; do
						rm -f "$FWDFAIL/$_old"
					done
				fi
				;;
			*.r2)
				mv "$_f" "${_f%.r2}.r3" 2>/dev/null
				;;
			*.r1)
				mv "$_f" "${_f%.r1}.r2" 2>/dev/null
				;;
			*)
				mv "$_f" "$_f.r1" 2>/dev/null
				;;
			esac
		fi
	done
}

# ★ 注册态门控（2026-10-11）—— 未注册的模组降频，避免为"收不到短信的模组"空转。
#   背景：实测每 2 秒一轮、双模组时整机 CPU 14.1%、fork 18.3/s（单核 580MHz）；
#   而每轮成本主要在起进程/开会话（同 5 条命令：直接调引擎 120ms、走 fzs-at 外壳 301ms）
#   ⇒ 省负载靠**降频**，不是把每轮做瘦。
#   判据：raw 里的 AT+CREG?（CS 域，EC200T 短信走这里）与 AT+CEREG?（PS 域，EC200N 走 IMS/PS），
#         只要有一条 stat ∈ {1,5}（已注册/漫游）就算"可用"；两条都不是才算"不可用"。
#   兜底：读不到/解析不出 ⇒ 一律按"可用"（宁可多跑一轮，也绝不因读不到状态就少读短信）。
#   状态存 tmpfs（不磨闪存）：文件内容 `<0=不可用|1=可用> <上次检查 epoch>`；重启后无记录 → 首轮必读。
#   ★ 判据本身不能拖慢高频档：读状态与解析**全程 shell 内建**（read/case/参数展开，0 个外部进程）。
#     （原来是 cat+sed+head 起 4 个进程、后来 awk 起 1 个 —— 都是"为省 CPU 反而多花 CPU"。）
reg_should_read() {   # $1=cfg（调用方先设好 $_now）
	read -r _s _t < "/tmp/fzs-sms/reg-$1" 2>/dev/null || return 0    # 无记录 → 读（重定向失败不刷日志）
	[ "$_s" = "0" ] || return 0                       # 上次可用（或字段异常）→ 照常读
	case "$_t" in ''|*[!0-9]*) return 0 ;; esac
	[ $((_now - _t)) -ge "$idle_interval" ] && return 0
	return 1                                          # 未注册且在休眠期 → 本轮跳过
}

# 从一份 raw 里取注册态：0=不可用 / 1=可用。全程内建，不起进程。
#   ★ 等价性已逐用例验证（含 +CREG 带 LAC/CI 的三段响应、脏数据、空文件）：
#     `case *1*|*5*` 对应 awk 的数字比较（stat 值域只有 0~5，子串匹配安全，
#     且能容忍行尾 CR —— 虽然 fzs-atio 输出已去掉 \r）。
reg_usable() {        # $1=raw 文件
	cs=''; ps=''
	while IFS= read -r _l; do
		case "$_l" in
		'+CREG: '*)  _t=${_l#+CREG: };  _t=${_t#*,}; cs=${_t%%,*} ;;
		'+CEREG: '*) _t=${_l#+CEREG: }; _t=${_t#*,}; ps=${_t%%,*} ;;
		esac
	done < "$1"
	s=$cs$ps
	[ -z "$s" ] && { echo 1; return; }                # 两条都读不到 → 按可用（fail-safe）
	case "$cs" in *1*|*5*) echo 1; return ;; esac
	case "$ps" in *1*|*5*) echo 1; return ;; esac
	echo 0
}

# 判断一份 raw 里有没有短信列表行（+CMGL）—— 取代原来的 `grep -q '^+CMGL'`。
#   〖刻意不用 case *+CMGL*〗纯 % 展开版本在 ash 下行为不稳，读循环是最可靠的写法；
#   反正 ② 紧接着就要读这个文件（解析/删除），多一遍内建读可忽略。
reg_has_cmgl() {      # $1=raw 文件
	while IFS= read -r _l; do
		case "$_l" in '+CMGL'*) return 0 ;; esac
	done < "$1"
	return 1
}

reg_mark() {          # $1=cfg $2=raw 文件（调用方先设好 $_now）
	_u=$(reg_usable "$2")
	[ "$_u" = "0" ] || _u=1
	printf '%s %s\n' "$_u" "$_now" > "/tmp/fzs-sms/reg-$1"
}

while :; do
	# ★★ 每轮重读配置（2026-10-07 踩坑后加，0.2.4-12）：
	#   守护是长驻进程，此前只在「启动时」读一次配置 → 用户改完
	#   「转发渠道 / 存储位置 / 轮询间隔」**必须重启守护才生效**。
	#   真实故障：勾了 PushPlus 却收不到转发（内存里还是 fwd_enabled=0）。
	#   模组开关本来就用 uci -q get 每轮实时读，这里统一成同一风格。
	#   （只读闪存、不磨损；解析 260 字节配置的开销可忽略。）
	if [ -f /etc/config/fzs-sms ]; then
		config_load fzs-sms
		config_get interval globals interval 2
		config_get idle_interval globals idle_interval 20
		config_get keep globals keep_in_storage 0
		config_get fwd_enabled globals fwd_enabled 0
		config_get fwd_channels globals fwd_channels ''
		# 转发模组选择（2026-10-07 加）。★ 默认值给 "1"（转）而不是 "0"：
		#   老版本升级上来时配置里没有这两项，若默认 "0" 会让用户
		#   **突然收不到转发**（正是今晚排查过的那类"改了不生效"事故的反面）。
		config_get fwd_modem1 globals fwd_modem1 1
		config_get fwd_modem2 globals fwd_modem2 1
		# 模组开关（1=启用 / 0=跳过）。★ 每轮用 config_load 出来的值即可，
		#   不再每轮每模组各起一个 uci 进程（那是 4 个进程/轮，纯浪费）。
		config_get m1on globals modem1 1
		config_get m2on globals modem2 1
	fi
	case "$m1on" in 0) ;; *) m1on=1 ;; esac
	case "$m2on" in 0) ;; *) m2on=1 ;; esac
	case "$interval" in ''|*[!0-9]*) interval=2 ;; esac
	[ "$interval" -lt 2 ] && interval=2
	# 未注册时的轮询间隔（默认 20 秒）：下限跟常态间隔一致，上限 300 秒
	case "$idle_interval" in ''|*[!0-9]*) idle_interval=20 ;; esac
	[ "$idle_interval" -lt "$interval" ] && idle_interval="$interval"
	[ "$idle_interval" -gt 300 ] && idle_interval=300
	# 规范化：非 "1" 一律视为 "0"（防止配置里写进空值/异常值）
	case "$fwd_modem1" in 1) ;; *) fwd_modem1=0 ;; esac
	case "$fwd_modem2" in 1) ;; *) fwd_modem2=0 ;; esac

	# 心跳（前端读它判断守护是否活着）
	# ★ 必须写 tmpfs（/tmp）：它每轮都更新，写到 overlay 闪存等于长期磨盘
	#   （interval=2 时是每天 4.3 万次写）。重启后 /tmp 清空，页面会短暂显示
	#   「守护未运行」，第一轮轮询后自愈 —— 这个代价远小于磨闪存。
	#   ★ 顺带把时刻读回 $_now（下面判据要用）—— 省掉一次 `date` 起进程。
	_now=$(date +%s)
	printf '%s\n' "$_now" > /tmp/fzs-sms/lastpoll

	# ① 一次调用读完全部「本轮该读」的模组 —— 用 fzs-atio 的批量模式（-b）。
	#    ★ 2026-10-11 改：旧做法是「每模组后台起一条 `fzs-at sms list` + wait」，
	#      实测每模组 ≈19 个进程、两模组≈38 个（shell 套 shell + grep/awk/readlink…），
	#      2 秒一轮 ⇒ fork/s ≈18、单核 580MHz 上占 14~16% CPU。这是整机"卡"的根。
	#      批量模式**一个进程读完全部模组**（判据与重试都在引擎里），每轮只剩 1~3 个进程。
	#    · 判据与旧实现一致：**终止行数恰好 = 2 + 命令数**（2=前导 AT/ATE0），最多 3 次、
	#      间隔 1s；不合格**写空文件**（下轮再读，绝不交出可能翻倍的脏数据）。
	#    · 命令清单见 /tmp/fzs-sms/cmds.txt（须与 fzs-at 的 cmd_sms_list 一致）。
	# ★ 先过注册态门控：未注册且在休眠期的模组本轮**直接跳过**（不传参、不占串口）。
	#   （$_now 已在上面的心跳处读好。）
	_read_list=''
	_bargs=''
	for cfg in modem1 modem2; do
		case "$cfg" in
		modem1) _m_on="$m1on" ;;
		modem2) _m_on="$m2on" ;;
		esac
		[ "$_m_on" = "0" ] && continue
		if reg_should_read "$cfg"; then
			_read_list="$_read_list $cfg"
			_bargs="$_bargs $cfg /tmp/fzs-sms/raw-$cfg"
		else
			# 跳过的模组必须清掉上一轮的 raw —— 否则 ② 会拿旧数据重复解析/重复入库
			rm -f "/tmp/fzs-sms/raw-$cfg"
		fi
	done
	# $_bargs 故意不加引号：要按空格拆成「模组 输出文件 …」多组参数
	[ -n "$_bargs" ] && /usr/bin/fzs-atio -t 800 -d 200 -b /tmp/fzs-sms/cmds.txt $_bargs >/dev/null 2>&1
	# 记录本轮读到的注册态（供下一轮判断谁该重查；未读到的模组不动它的记录）
	for cfg in $_read_list; do
		reg_mark "$cfg" "/tmp/fzs-sms/raw-$cfg"
	done
	# ② 串行解析入库 —— inbox.jsonl / seen / parts 是共享状态文件，
	#    解析必须串行，否则两个模组并发「读-改-写」会互相覆盖丢数据。
	#    ★ 只解析本轮**真正读过**的模组（跳过的模组没有新 raw；$_read_list 里也只有启用的模组）。
	for cfg in $_read_list; do
		if [ -s "/tmp/fzs-sms/raw-$cfg" ] && reg_has_cmgl "/tmp/fzs-sms/raw-$cfg"; then
			# 与页面「清空收件箱」共用一把文件锁：收件箱/发件箱是共享文件，
			# 两边都是「读-改-写」，并发会互相覆盖。
			out=$( ( flock 9; UC_SUB=poll UC_ARG1="$cfg" UC_ARG2="/tmp/fzs-sms/raw-$cfg" ucode "$UC_SMS" 2>/dev/null ) 9>/tmp/fzs-sms-state.lock )
			# ★ 自动清理：把「本轮真正入库」的条目从 SIM/模组删掉。
			#   keep_in_storage=1 时保留（用户想让短信留在卡上）。
			#   分片未拼齐的段不在 del 名单里 → 不会被误删（下轮继续拼）。
			if [ "$keep" != "1" ] && [ -n "$out" ]; then
				del=$(printf '%s' "$out" | sed -n 's/.*"del":"\([0-9,]*\)".*/\1/p')
				if [ -n "$del" ]; then
					/usr/libexec/fzs-at sms delmulti "$cfg" "$del" >/dev/null 2>&1
				fi
			fi
		fi
	done

	# ③ 转发
	fwd_flush

	# 轮询间隔
	# ★ 2026-10-07 晚 22:5x 简化：原先有「页面活跃时用 FAST、
	#   离开后回落到 interval」的两档自适应（页面每次拉取会刷新 /tmp/fzs-sms/active）。
	#   但两档的值都已调成 2 秒，**两档合一 → 参数与整套 active 判定都是多余的**。
	#   现在只保留一个 interval；页面侧的 active 标志文件已无人使用
	#   （前端写它的代码后续一并清理，留着也无害）。
	# ★ 2026-10-11 加：本轮**一个模组都没读**（都在"未注册休眠"里）→ 睡 idle_interval。
	#   这时的空转没有任何意义，直接睡到下次该重查的时候，是省负载的关键一跳。
	if [ -z "$_read_list" ]; then
		sleep "$idle_interval"
	else
		sleep "$interval"
	fi
done
