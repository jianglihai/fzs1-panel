#!/bin/sh
# fzs-simretry —— 开机读卡自愈（2026-10-25）
#
# ★ 为什么需要它（现场故障的根因）
#   EC200T / EC200N 的 AT+QSIMDET 出厂值是 0,0，即**热插拔检测关闭**。
#   这决定了模组的 SIM 初始化时机：**只在开机那一瞬间做一次**（以及
#   AT+CFUN 0→1 切换时），之后既不检测拔插、也**不会自己重试**。
#   于是只要开机那一刻 SIM 没握上手（卡没插到底 / 触点氧化 / 卡座弹片
#   压力不足 / 上电时序碰上模组忙），模组就**永久停在「无卡」状态**：
#   面板一直读不到卡，把卡拔出来重插也没用，只有重启整机才可能恢复。
#   —— 这正好解释了"这张卡以前能读、后来一直读不到，换张卡又好了"。
#
# ★ 这个脚本做什么
#   开机 30 秒后（等 USB 枚举 + 模组自身初始化完），分别读两块模组的卡状态：
#     · 已经 READY  → **完全不碰**（不影响正在上网/收短信的模组）
#     · 读不到      → 调 `fzs-at sim reset N` 强制重跑一次 SIM 初始化
#   最多 2 轮，仍失败就放弃并写 syslog —— 绝不无限重试。
#
# ★ 边界（实测 2026-10-25）
#   能救「开机握手失败被锁死」；救不了真·接触不良。
#   现场那张联通卡：CFUN 循环 3 轮 + 模组软重启 + QSIMDET=1,1 全部无效，
#   CPIN? 恒 ERROR 10、QINISTAT 恒 0、AT+CSIM 直发 APDU 也无响应
#   ⇒ 属于硬件侧（清洁触点 / 卡背垫片加压 / 换卡座），软件无能为力。

AT=/usr/libexec/fzs-at
[ -x "$AT" ] || exit 0

log() { logger -t fzs-simretry "$*" 2>/dev/null; }

# 等 USB 枚举 + 模组内部 SIM 初始化完成（实测开机 20~25 秒才稳定）
sleep 30

for _t in 1 2; do
	_round=0
	while [ "$_round" -lt 2 ]; do
		_round=$((_round + 1))
		_st=$("$AT" sim status "$_t" 2>/dev/null | sed -n 's/.*"card":"\([a-z]*\)".*/\1/p')
		case "$_st" in
		ok)
			# 第二轮才 READY → 说明是刚才救回来的，记一笔
			[ "$_round" -gt 1 ] && log "模组$_t 重新初始化后已恢复读卡"
			break
			;;
		"")
			# 连 JSON 都没解析出来：模组没起来（USB 没枚举 / 无响应），别硬来
			break
			;;
		*)
			[ "$_round" -eq 1 ] && log "模组$_t 读卡异常（$_st），尝试重新初始化"
			_out=$("$AT" sim reset "$_t" 2>/dev/null)
			case "$_out" in
			*'"card":"ok"'*)
				log "模组$_t 重新初始化成功，卡已恢复"
				break
				;;
			esac
			[ "$_round" -lt 2 ] && sleep 15
			;;
		esac
	done
done

exit 0
